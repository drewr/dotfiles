# -*- sh -*-

e() {
    local d

    if [[ -z "$1" ]]; then
        d=../$(basename $PWD)
    else
        d="$1"
    fi

    emacs -nw "$d"
}

psg() { 
  ps="ps -ef"
  [ "$OS" = "Darwin" ] && ps="ps jax"
  eval $ps | grep -i $1 | grep -v grep
}

screen_running() {
  [[ -n $STY ]]
}

tmux_running() {
  [[ -n $TMUX ]]
}

sshs() {
  h=$1
  t=${2:-$1}
  if tmux_running; then
    tmux neww -n $t "exec ssh $h"
  elif screen_running; then
    screen -t $t exec ssh $h
  else
    ssh $h
  fi
}

gitcb() {
  b=$1
  git checkout -b $(basename $b) $b
}

# Re-resolve the agent before every command, so long-lived shells follow a
# new forwarded connection or drop a dead one.
preexec_functions+=ssh_auth_sock_pick

# Whatever drops a session (ssh, mosh, autossh, a dead pty) can't tell the
# terminal to stop reporting the mouse, so every pointer move arrives as
# ^[[<35;80;20M text. Nothing should hold mouse or focus reporting at a
# prompt, so turn it all off before each one. Reports sent while the
# connection hung are already queued on the tty, so also discard those,
# handing any real typeahead back to the line editor.
reset_mouse_reporting() {
  [[ -t 0 && -t 1 ]] || return
  setopt local_options extendedglob
  printf '\e[?1000l\e[?1002l\e[?1003l\e[?1006l\e[?1015l\e[?1004l'
  local c buf=
  while read -rsk1 -t 0 c; do buf+=$c; done
  buf=${buf//$'\e'\[<[0-9;]##[Mm]/}
  buf=${buf//$'\e'\[[IO]/}
  [[ -n $buf ]] && print -rz -- "$buf"
  return 0
}
precmd_functions+=reset_mouse_reporting

enumerate_ssh() {
  sort | awk -v pat="host $1%02d.$2\n  hostname %s\n\n" \
    'BEGIN{c=1};{printf(pat, c++, $1)}'
}

lset() {
  local profile=$1
  if [[ -z $profile ]]; then
    echo $LEDGER_FILE
  else
    case $profile in
      (trinity)
        LEDGER_FILE=~/etc/trinity/trinity.dat
        ;;
      (*)
        LEDGER_FILE=~/etc/ledger/${profile}.dat
        ;;
    esac
  fi
}

l() {
  if [[ $TERM == "dumb" ]]; then
    COLUMNS=80 ledger $* | cat
  else
    COLUMNS=80 ledger $*
  fi
}

snapdir() {
  dirname="$(basename $(pwd))"
  snapdir="../${dirname}-`date +%Y%m%d%H%M%S`"

  mkdir "$snapdir"
  tar cf - . | ( cd ${snapdir}; tar xf - )
}

_sum_div() {
  local s=0 n
  while read n; do (( s += n )); done
  printf "%0.2f\n" $(( s / $1 ))
}

mib() { _sum_div 1048576.0 }
gib() { _sum_div 1073741824.0 }

avg() {
  s=0
  c=0
  while read n; do
    s=$((s+$n))
    c=$((c+1))
  done
  printf "%0.2f\n" $((s/(c*1.0)))
}

max() {
  read max
  while read n; do
    if [[ n -gt $max ]]; then
      max=$n
    fi
  done
  printf "$max\n"
}

min() {
  read min
  while read n; do
    if [[ n -lt $min ]]; then
      min=$n
    fi
  done
  printf "$min\n"
}

# Cross-platform k8s-style random strings. Default to 12 bytes
randstr() {
  LC_ALL=C tr -dc 'bcdfghjklmnpqrstvwxz2456789' < /dev/urandom | head -c "${1:-12}" && echo
}
