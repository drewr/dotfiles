# -*- sh -*-

gitize() {
  if [[ ! -d .git ]]; then
    git init
    touch .gitignore
    git add .gitignore
    git commit -a -m "Create repo."
    git gc
  else
    echo $PWD is already a git repo
  fi
}

versionize() {
  local file=$1 ext=${1:e} ver
  ver=$(git log -1 --date=format:%Y%m%d%H%M%S --format=%ad+%h) || return
  cp $file ${file:r}-$ver${ext:+.$ext}
}

autoload -Uz vcs_info

# Plain markers in dumb terminals (Emacs shell); zsh emits colors anyway.
() {
  local red green yellow off
  if [[ $TERM != dumb ]]; then
    red=%F{red} green=%F{green} yellow=%F{yellow} off=%f
  fi
  zstyle ':vcs_info:*' enable git
  zstyle ':vcs_info:*' check-for-changes true
  zstyle ':vcs_info:*' stagedstr "$green●"
  zstyle ':vcs_info:*' unstagedstr "$yellow●"
  zstyle ':vcs_info:*' untrackedstr "$red●"
  zstyle ':vcs_info:*' formats "[%b%c%u$off]"
  zstyle ':vcs_info:git*+set-message:*' hooks untracked
}

# Append the untracked marker to %u.
+vi-untracked() {
  git ls-files --others --exclude-standard 2>/dev/null | read -r || return 0
  local mark
  zstyle -s ':vcs_info:git' untrackedstr mark
  hook_com[unstaged]+=$mark
}

update_prompt_info() {
  local nix_info=$(zsh-nix-env)
  if [[ -z $nix_info ]]; then
    nix_prompt=
  elif [[ $TERM == dumb ]]; then
    nix_prompt="[$nix_info]"
  else
    nix_prompt="[%F{blue}$nix_info%f]"
  fi
  vcs_info
}
precmd_functions+=update_prompt_info
