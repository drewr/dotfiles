# -*- sh -*-

gitize() {
  if [[ ! -d .git ]]; then
    git init
    touch .gitignore
    git add .gitignore
    git commit -a -m "Create repo."
    git gc
  else
    echo $PWD is already a git repo
  fi
}

versionize() {
  local file=$1
  local ver=$(git log --pretty=format:"%ai %h" -1 | perl -pe 's,(\d\d\d\d)-(\d\d)-(\d\d) (\d\d):(\d\d):(\d\d) [^ ]+ ([a-z0-9]+),\1\2\3\4\5\6+\7,')
  local versionedfile=$(echo $file | perl -pe "s,(.*)\.([^.]+)\$,\$1-${ver}.\$2,")
  cp $file $versionedfile
}

autoload -Uz vcs_info

# No color escapes in dumb terminals (Emacs shell).
if [[ $TERM == dumb ]]; then
  _c_red= _c_green= _c_yellow= _c_blue= _c_off=
else
  _c_red=%F{red} _c_green=%F{green} _c_yellow=%F{yellow} _c_blue=%F{blue} _c_off=%f
fi

zstyle ":vcs_info:*" check-for-changes true
zstyle ":vcs_info:*" stagedstr "${_c_green}●"
zstyle ":vcs_info:*" unstagedstr "${_c_yellow}●"
zstyle ":vcs_info:(sv[nk]|bzr):*" branchformat "%b${_c_red}:${_c_yellow}%r${_c_off}"
zstyle ":vcs_info:*" enable git svn bzr hg

update_prompt_info() {
  local nix_info=$(zsh-nix-env)
  nix_prompt=${nix_info:+"[${_c_blue}${nix_info}${_c_off}]"}

  if [[ -z $(git ls-files --other --exclude-standard 2>/dev/null) ]]; then
    zstyle ":vcs_info:*" formats "[%b%c%u${_c_off}]"
  else
    zstyle ":vcs_info:*" formats "[%b%c%u${_c_red}●${_c_off}]"
  fi
  vcs_info
}
precmd_functions+=update_prompt_info
