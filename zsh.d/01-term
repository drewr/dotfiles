# -*- sh -*-

if [[ $TERM == dumb ]]; then
  # Emacs shell and Tramp: no line editor or bracketed-paste escapes.
  unset zle_bracketed_paste
  unsetopt zle
  PAGER=cat; export PAGER
elif ! infocmp $TERM >/dev/null 2>&1; then
  # No terminfo entry here for this terminal (e.g. xterm-ghostty over ssh).
  TERM=xterm-256color
fi
