# -*- sh -*-

# Shell-driven window and pane naming for terminal multiplexers (tmux,
# screen). Empty by default, so tmux's automatic-rename names windows.
#
# Examples:
#
# Name the tmux window after the cwd on every cd (this turns off
# automatic-rename for that window):
#
#   update_tmux_title() {
#     [[ -n $TMUX ]] && tmux rename-window "$(print -D $PWD)"
#   }
#   chpwd_functions+=update_tmux_title
#
# Set the pane title to the cwd at each prompt; programs that set their
# own title (e.g. agent harnesses) override it while they run. Pair with
# `setw -g automatic-rename-format '#{pane_title}'` in tmux.conf:
#
#   set_pane_title() { print -Pn '\e]2;%~\a' }
#   precmd_functions+=set_pane_title
#
# Set the screen window title to the cwd on every cd:
#
#   update_screen_title() {
#     [[ -n $STY ]] && screen -X title "$(print -D $PWD)"
#   }
#   chpwd_functions+=update_screen_title
