# -*- sh -*-

typeset -U cdpath fpath

# Arrays, so `hooks+=fn` in zsh.d appends an element, not a string.
typeset -a preexec_functions precmd_functions

# Raise a low open-file limit (macOS defaults to 256) without lowering a
# higher one.
() {
  local n=$(ulimit -n)
  [[ $n == <-> ]] && (( n < 1024 )) && ulimit -n 1024
}

setopt AUTO_CD
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt EXTENDED_HISTORY
setopt SHARE_HISTORY
unsetopt TRANSIENT_RPROMPT
setopt PROMPT_SUBST
setopt AUTO_PUSHD
setopt ZLE emacs

WORDCHARS='*?_[]~=&;!#$%^(){}'

HISTSIZE=10000
SAVEHIST=10000
HISTFILE=~/.history
