#!/bin/sh
# Emit the git ssh signing key for gpg.ssh.defaultKeyCommand.
#
# git takes the first line of this command's output as the signing key and runs
# it without a shell, so this cannot be an inline pipeline. git only accepts a
# literal public key here: the line must start with "key::" (or "ssh-", which
# ecdsa keys never do), so every key is emitted with the "key::" prefix. A file
# path is rejected with "succeeded but returned no keys".
#
# Filtering matters: a forwarded agent typically lists the RSA key first, and
# signing with it produces a valid signature that allowed_signers rejects ("No
# principal matched"). Only the keys authorized in ~/.ssh/allowed_signers are
# considered: ecdsa-sha2-nistp256 (preferred) and ssh-ed25519.
#
# Order:
#   1. an authorized key already held by the agent (ecdsa first, then ed25519)
#   2. otherwise, load an authorized private key from disk (~/.ssh/id_ecdsa,
#      then id_ed25519) into the running agent with ssh-add, then use it as in 1
#
# Signing always goes through the agent: git hands ssh-keygen the public key
# and ssh-keygen asks the agent to sign. With no reachable agent nothing can
# sign, so this prints the reason to stderr and emits nothing, and git reports
# that user.signingKey needs to be set.

agent_key() {
	keys=$(ssh-add -L 2>/dev/null)
	for type in ecdsa-sha2-nistp256 ssh-ed25519; do
		key=$(printf '%s\n' "$keys" | grep -m1 "^$type ")
		if [ -n "$key" ]; then
			printf 'key::%s\n' "$key"
			return 0
		fi
	done
	return 1
}

agent_key && exit 0

# ssh-add exits 2 when it cannot reach an agent at all.
ssh-add -l >/dev/null 2>&1
if [ $? -eq 2 ]; then
	echo "ssh-signing-key: no ssh agent reachable (SSH_AUTH_SOCK=${SSH_AUTH_SOCK:-unset})" >&2
	exit 1
fi

for f in "$HOME/.ssh/id_ecdsa" "$HOME/.ssh/id_ed25519"; do
	if [ -f "$f" ] && ssh-add -q "$f" </dev/null 2>/dev/null; then
		agent_key && exit 0
	fi
done

echo "ssh-signing-key: no authorized signing key in the agent or ~/.ssh" >&2
exit 1
