#!/bin/sh
# Emit the git ssh signing key for gpg.ssh.defaultKeyCommand.
#
# git takes the first line of this command's output as the signing key and runs
# it without a shell, so this cannot be an inline pipeline. git only accepts a
# literal public key here: the line must start with "key::" (or "ssh-", which
# ecdsa keys never do), so every key is emitted with the "key::" prefix. A file
# path is rejected with "succeeded but returned no keys".
#
# This machine holds no private keys: signing goes through whatever agent
# SSH_AUTH_SOCK points at, which in practice is a forwarded agent from the
# connected device (laptop or phone). With no device connected nothing can
# sign, and that is intentional.
#
# Only keys authorized in ~/.ssh/allowed_signers are emitted. A forwarded
# agent typically lists the RSA key first, and signing with an unauthorized
# key produces a signature allowed_signers rejects ("No principal matched").
# A second device whose agent key is not listed here would fail the same way,
# so this prints the agent's key list to stderr instead of guessing.
#
# Order: ecdsa-sha2-nistp256 (preferred) then ssh-ed25519, first authorized
# match wins.

# Print the base64 blob of every key in allowed_signers. The format is
#   principal [options] keytype base64 [comment]
# so the keytype -- the first field after the principal that looks like an
# algorithm name -- is followed by the blob.
authorized_blobs() {
	awk '
		/^[[:space:]]*#/ { next }
		{
			for (i = 2; i < NF; i++)
				if ($i ~ /^(ssh-|ecdsa-|sk-)/) { print $(i + 1); next }
		}
	' "$HOME/.ssh/allowed_signers" 2>/dev/null
}

agent_key() {
	keys=$(ssh-add -L 2>/dev/null) || return 1
	[ -n "$keys" ] || return 1
	allowed=$(authorized_blobs)
	[ -n "$allowed" ] || return 1
	printf '%s\n' "$keys" | allowed="$allowed" awk '
		BEGIN {
			n = split(ENVIRON["allowed"], a, "\n")
			for (i = 1; i <= n; i++) ok[a[i]] = 1
		}
		($1 == "ecdsa-sha2-nistp256" || $1 == "ssh-ed25519") && ($2 in ok) {
			if ($1 == "ecdsa-sha2-nistp256" && !ecdsa) ecdsa = $1 " " $2
			else if ($1 == "ssh-ed25519" && !ed25519) ed25519 = $1 " " $2
		}
		END {
			if (ecdsa) print "key::" ecdsa
			else if (ed25519) print "key::" ed25519
		}
	'
}

out=$(agent_key)
if [ -n "$out" ]; then
	printf '%s\n' "$out"
	exit 0
fi

# ssh-add exits 2 when it cannot reach an agent at all.
ssh-add -l >/dev/null 2>&1
if [ $? -eq 2 ]; then
	echo "ssh-signing-key: no ssh agent reachable (SSH_AUTH_SOCK=${SSH_AUTH_SOCK:-unset})" >&2
	echo "ssh-signing-key: signing needs a live forwarded ssh session from your device" >&2
	exit 1
fi

echo "ssh-signing-key: no agent key is listed in ~/.ssh/allowed_signers; agent holds:" >&2
ssh-add -l 2>&1 | sed 's/^/  /' >&2
exit 1
