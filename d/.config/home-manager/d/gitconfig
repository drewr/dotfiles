[user]
name = Drew Raines
email = drew@raines.me
# signingkey is deliberately unset; gpg.ssh.defaultKeyCommand (below) resolves
# the key from the agent, so signing works on hosts that hold only the public
# half. Trade-off: signing now requires an agent everywhere. To go back to
# signing from the local key (or its .pub through the agent), uncomment:
# signingkey = ~/.ssh/id_ed25519.pub

[gpg]
format = ssh

[gpg "ssh"]
allowedsignersfile = ~/.ssh/allowed_signers
# ssh-add -L lists the forwarded RSA key first, and git takes the first line,
# so the helper pins the ecdsa key that allowed_signers authorizes.
defaultKeyCommand = ssh-signing-key

[github]
user = drewr

[alias]
ci = commit
co = checkout
s = status -su
st = status -su
lg = log --graph --decorate --oneline --all
ll = log --date=local
b = branch
ver = "!git log --pretty=format:'%ai %h' -1 | perl -pe 's,(\\d\\d\\d\\d)-(\\d\\d)-(\\d\\d) (\\d\\d):(\\d\\d):(\\d\\d) [^ ]+ ([a-z0-9]+),\\1\\2\\3\\4\\5\\6\\7,'"
pr = "!f() { git fetch origin pull/$1/head:pull/$1; }; f"

[apply]
whitespace = strip

[diff]
color = auto
rename = copy 

[push]
default = tracking

[pull]
rebase = false

[pager]
color = true 

[status]
color = auto

[rerere]
enabled = true

[credential]
helper = store

[commit]
gpgsign = true

[init]
defaultBranch = main
