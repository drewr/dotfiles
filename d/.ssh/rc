#!/bin/sh
# sshd runs this file at session start (before the user's shell).
# When agent forwarding is active, SSH_AUTH_SOCK is already set to the new
# socket. We create a stable symlink so existing shells (e.g. inside tmux)
# can always find the current agent without knowing the random socket path.
# This machine keeps no local keys, so forwarding is the only signing source.
#
# Skip when the forwarded socket IS the stable symlink: that happens when an
# SSH connection loops back through this machine (local->local, or a chain
# passing through here twice). Linking it to itself would create an infinite
# self-referential symlink and silently break agent forwarding everywhere.
#
# Only repoint when this session actually has a usable agent (ssh-add -l exits
# 0 when it lists identities). A one-shot `ssh host command` session gets a
# socket that dies seconds after it starts; letting such sessions repoint the
# symlink makes every other shell follow a corpse.
if [ -n "$SSH_AUTH_SOCK" ] && [ "$SSH_AUTH_SOCK" != "$HOME/.ssh/ssh_auth_sock" ] \
   && SSH_AUTH_SOCK="$SSH_AUTH_SOCK" ssh-add -l >/dev/null 2>&1; then
    stable="$HOME/.ssh/ssh_auth_sock"
    # Keep a good symlink when this session is non-interactive (no tty), so a
    # short-lived notty session cannot clobber an agent another shell is using.
    if [ -t 0 ] || [ ! -S "$stable" ] \
       || ! SSH_AUTH_SOCK="$stable" ssh-add -l >/dev/null 2>&1; then
        mkdir -p "$HOME/.ssh"
        ln -sf "$SSH_AUTH_SOCK" "$stable"
        # Tell running tmux sessions to use the stable symlink so that
        # update_auth_sock picks it up in every pane on the next command.
        if command -v tmux >/dev/null 2>&1; then
            tmux list-sessions 2>/dev/null | cut -d: -f1 | while read -r s; do
                tmux setenv -t "$s" SSH_AUTH_SOCK "$stable"
            done
        fi
    fi
fi
