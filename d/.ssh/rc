#!/bin/sh
# Point ~/.ssh/ssh_auth_sock at this session's forwarded agent so existing
# shells can find it. Skip when the socket is already the symlink (a looped
# connection would link it to itself) or the agent holds no keys.
if [ -n "$SSH_AUTH_SOCK" ] && [ "$SSH_AUTH_SOCK" != "$HOME/.ssh/ssh_auth_sock" ] \
   && SSH_AUTH_SOCK="$SSH_AUTH_SOCK" ssh-add -l >/dev/null 2>&1; then
    stable="$HOME/.ssh/ssh_auth_sock"
    # A short-lived non-tty session must not replace a working symlink.
    if [ -t 0 ] || [ ! -S "$stable" ] \
       || ! SSH_AUTH_SOCK="$stable" ssh-add -l >/dev/null 2>&1; then
        mkdir -p "$HOME/.ssh"
        ln -sf "$SSH_AUTH_SOCK" "$stable"
        # New tmux panes inherit the symlink.
        if command -v tmux >/dev/null 2>&1; then
            tmux list-sessions 2>/dev/null | cut -d: -f1 | while read -r s; do
                tmux setenv -t "$s" SSH_AUTH_SOCK "$stable"
            done
        fi
    fi
fi
