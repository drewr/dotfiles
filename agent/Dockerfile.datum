# Build one harness's rootfs with nix inside BuildKit, pinned by flake.lock, then
# ship only the rootfs. HARNESS picks packages.<harness> from flake.nix (claude,
# gemini, codex, opencode, pi, hermes). sandbox=false because a BuildKit RUN step
# cannot create the namespaces the nix sandbox needs; inputs stay pinned by the
# lock.
FROM docker.io/nixos/nix:2.35.3@sha256:ff480dbb23511aa1c10710aa068ceea5b93fed9bfce5f5379f3a6b07282cbc7b AS build
ARG HARNESS=claude
COPY . /src
# cache.numtide.com is llm-agents.nix's binary cache (key from its flake's
# nixConfig); without it nix compiles codex, gemini-cli and hermes from source.
RUN nix --extra-experimental-features 'nix-command flakes' --option sandbox false \
      --option extra-substituters https://cache.numtide.com \
      --option extra-trusted-public-keys 'niks3.numtide.com-1:DTx8wZduET09hRmMtKdQDxNNthLQETkc/yaX7M4qK0g=' \
      build --out-link /result "path:/src#${HARNESS}" \
 && cp -a /result/. /rootfs

FROM scratch
COPY --from=build /rootfs/ /
ENTRYPOINT ["/bin/sh", "/init"]
