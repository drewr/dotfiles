#!/usr/bin/env bash
# Spawn and reach agent sandboxes on Datum Compute (unikernel class). Each
# session runs one harness's image: claude, gemini, codex, opencode, pi, hermes.
#
#   agent-sandbox new NAME [--agent HARNESS] [--key PUBKEY_FILE] [--no-home]
#                                                create a session and wait for SSH
#   agent-sandbox ssh NAME [ssh args...]         connect (interactive by default)
#   agent-sandbox ls                             list sessions
#   agent-sandbox logs NAME [logs args...]       instance logs
#   agent-sandbox rm NAME                        save workspaces, then delete workload,
#                                                secret and local state
#
# Each session gets a fresh iroh secret and SSH host key generated here, stored
# in a per-session Datum Secret and under $AGENT_SANDBOX_STATE/NAME. The client
# derives the iroh ticket from the secret and pins the host key, so nothing is
# read from instance logs and there is no trust-on-first-use.
#
# Model providers: every key in the Datum Secret agent-providers (e.g.
# ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY, TOKENROUTER_API_KEY) is
# passed to the session as a variable of the same name. Only the key names are
# read here; the values go straight from the Secret to the instance. OAuth
# logins inside a session (claude /login, codex login, ...) persist in the
# shared home. See agent/providers and agent-providers for routers such as
# tokenrouter and subconscious.
#
# Shared home: if the Datum Secret agent-home exists (JuiceFS metadata ticket
# and URL plus a bucket-scoped S3 key), every session mounts the same JuiceFS
# volume as HOME, so ~/.claude and ~/work are shared live across sessions, as
# on one laptop. --no-home gives a session a private, ephemeral HOME instead.
#
# Needs: datumctl (logged in), ssh, ssh-keygen, openssl, jq, and dumbpipe (falls
# back to `nix build nixpkgs#dumbpipe`).
set -euo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
STATE=${AGENT_SANDBOX_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/agent-sandbox}
# Pinned image per harness: "harness image-ref" lines (agent/images).
IMAGES=${AGENT_SANDBOX_IMAGES:-$HERE/images}
HARNESS=${AGENT_SANDBOX_AGENT:-claude}
# Datum production (api.datum.net), project drewr-y4nd1b. Sessions depend only
# on features in production; staging differs (no IPv4 egress in us-east-1, and
# a default network whose us-east-1 VPC never provisioned).
# Session names are email@api-host. An explicit DATUM_SESSION wins, so
# `DATUM_SESSION=… agent-sandbox rm NAME` acts where the caller expects.
export DATUM_SESSION=${AGENT_SANDBOX_DATUM_SESSION:-${DATUM_SESSION:-aaraines@gmail.com@api.datum.net}}
PULL_SECRET=${AGENT_SANDBOX_PULL_SECRET:-ghcr-drewr}
LOCATION=${AGENT_SANDBOX_LOCATION:-us-east-1}
NETWORK=${AGENT_SANDBOX_NETWORK:-default}
INSTANCE_TYPE=${AGENT_SANDBOX_INSTANCE_TYPE:-datumcloud/d1-standard-2}
# The relay instances have chosen as home in every run so far (n0 use1, Virginia).
RELAY=${AGENT_SANDBOX_RELAY:-https://use1-1.relay.n0.iroh.link./}
HOME_SECRET=${AGENT_SANDBOX_HOME_SECRET:-agent-home}
PROVIDERS_SECRET=${AGENT_SANDBOX_PROVIDERS_SECRET:-agent-providers}
# Extra `juicefs mount` options for the shared home (passed as JFS_MOUNT_OPTS).
JFS_OPTS=${AGENT_SANDBOX_JFS_OPTS:-}

die() { echo "agent-sandbox: $*" >&2; exit 1; }
usage() { sed -n '2,8p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 2; }

dumbpipe_bin() {
  command -v dumbpipe 2>/dev/null && return
  echo "$(nix build --no-link --print-out-paths nixpkgs#dumbpipe)/bin/dumbpipe"
}

session_dir() {
  [[ $1 =~ ^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$ ]] \
    || die "name must be lowercase letters, digits and '-', at most 40 chars"
  echo "$STATE/$1"
}

# iroh endpoint public key (hex) for a hex ed25519 secret on stdin.
endpoint_pubhex() {
  { printf '302e020100300506032b657004220420'; cat; } | xxd -r -p \
    | openssl pkey -inform DER -pubout -outform DER | tail -c 32 | xxd -p -c 64
}

# z-base-32 label for iroh's DNS discovery name _iroh.<label>.dns.iroh.link.
endpoint_z32() {
  local hex bits='' i n out='' alpha=ybndrfg8ejkmcpqxot1uwisza345h769
  hex=$(endpoint_pubhex)
  for ((i = 0; i < ${#hex}; i++)); do
    n=$((16#${hex:i:1}))
    bits+=$(( (n >> 3) & 1 ))$(( (n >> 2) & 1 ))$(( (n >> 1) & 1 ))$(( n & 1 ))
  done
  while (( ${#bits} % 5 )); do bits+='0'; done
  for ((i = 0; i < ${#bits}; i += 5)); do out+=${alpha:$((2#${bits:i:5})):1}; done
  echo "$out"
}

# An iroh endpoint ticket that carries the relay URL, so the client dials the
# relay directly instead of depending on DNS discovery, which instances have
# failed to publish to (sp4/RESULTS.md, agent/README.md). Wire format, as
# decoded from dumbpipe tickets: 00 | pubkey(32) | n_addrs | 00 len url.
endpoint_ticket() {
  local relay=$1 urlhex
  urlhex=$(printf '%s' "$relay" | xxd -p -c 256)
  (( ${#relay} < 128 )) || die "relay URL too long"
  { printf '00%s0100%02x%s' "$(endpoint_pubhex)" "${#relay}" "$urlhex"; } | xxd -r -p \
    | base32 -w0 | tr '[:upper:]' '[:lower:]' | tr -d '=' | sed 's/^/endpoint/'
}

# Key names in the providers Secret that are valid variable names. Values are
# never read here.
provider_key_names() {
  datumctl get secret "$PROVIDERS_SECRET" -o json 2>/dev/null \
    | jq -r '.data // {} | keys[]' | grep -E '^[A-Za-z_][A-Za-z0-9_]*$' || true
}

authorized_keys() {
  if [ -n "${1:-}" ]; then cat "$1"; return; fi
  if ssh-add -L 2>/dev/null | grep -q '^ssh-'; then ssh-add -L; return; fi
  for f in "$HOME"/.ssh/id_ed25519.pub "$HOME"/.ssh/id_ecdsa.pub "$HOME"/.ssh/id_rsa.pub; do
    [ -f "$f" ] && { cat "$f"; return; }
  done
  die "no public key: load one into ssh-agent or pass --key FILE"
}

cmd_new() {
  local name=${1:?usage: agent-sandbox new NAME [--agent HARNESS] [--key FILE] [--no-home]}; shift
  local key='' home=1 harness=$HARNESS
  while [ $# -gt 0 ]; do
    case $1 in
      --agent) harness=$2; shift 2 ;;
      --key) key=$2; shift 2 ;;
      --no-home) home=0; shift ;;
      *) die "unknown option $1" ;;
    esac
  done
  if [ $home = 1 ] && ! datumctl get secret "$HOME_SECRET" >/dev/null 2>&1; then
    echo "agent-sandbox: no Secret $HOME_SECRET; this session's HOME is ephemeral" >&2
    home=0
  fi
  local image=${AGENT_SANDBOX_IMAGE:-}
  [ -n "$image" ] || image=$(awk -v h="$harness" '$1 == h {print $2}' "$IMAGES" 2>/dev/null)
  [ -n "$image" ] || die "no image for harness '$harness' in $IMAGES (have: $(awk '!/^#/ && NF {printf "%s ", $1}' "$IMAGES" 2>/dev/null))"
  local dir; dir=$(session_dir "$name")
  [ -e "$dir" ] && die "session $name exists locally ($dir); rm it first"

  mkdir -p "$dir"; chmod 700 "$dir"
  (
    umask 077
    openssl rand -hex 32 > "$dir/iroh_secret"
    endpoint_ticket "$RELAY" < "$dir/iroh_secret" > "$dir/ticket"
    ssh-keygen -q -t ed25519 -N '' -C "agent-$name" -f "$dir/host_key"
    echo "agent-$name $(cut -d' ' -f1,2 "$dir/host_key.pub")" > "$dir/known_hosts"
    authorized_keys "$key" > "$dir/authorized_keys"
    # A --key FILE.pub with its private key beside it is also the identity.
    if [ -n "$key" ] && [ -f "${key%.pub}" ] && [ "${key%.pub}" != "$key" ]; then
      realpath "${key%.pub}" > "$dir/identity"
    fi
  )
  grep -q '^endpoint' "$dir/ticket" || die "could not derive the iroh ticket"

  {
    printf 'apiVersion: v1\nkind: Secret\nmetadata:\n  name: agent-%s\ntype: Opaque\nstringData:\n' "$name"
    printf '  IROH_SECRET: "%s"\n' "$(cat "$dir/iroh_secret")"
    printf '  AUTHORIZED_KEYS_B64: "%s"\n' "$(base64 -w0 < "$dir/authorized_keys")"
    printf '  SSH_HOST_KEY_B64: "%s"\n' "$(base64 -w0 < "$dir/host_key")"
  } | datumctl apply -f - >/dev/null
  local home_env=''
  if [ $home = 1 ]; then
    for k in META_TICKET META_URL AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY; do
      home_env+=$(printf '                - name: %s\n                  valueFrom:\n                    secretKeyRef: { name: %s, key: %s }\n' "$k" "$HOME_SECRET" "$k")
      home_env+=$'\n'
    done
  fi
  # One secretKeyRef per provider key (the unikernel class has no envFrom).
  local provider_env='' provider_keys='' k
  for k in $(provider_key_names); do
    provider_env+=$(printf '                - name: %s\n                  valueFrom:\n                    secretKeyRef: { name: %s, key: %s }\n' "$k" "$PROVIDERS_SECRET" "$k")
    provider_env+=$'\n'
    provider_keys+="$k "
  done

  datumctl apply -f - >/dev/null <<EOF
apiVersion: compute.datumapis.com/v1alpha
kind: Workload
metadata:
  name: agent-$name
  labels:
    agent-sandbox: "true"
    agent-harness: $harness
spec:
  template:
    spec:
      runtime:
        class: unikernel
        resources:
          instanceType: $INSTANCE_TYPE
        sandbox:
          imagePullSecrets:
            - name: $PULL_SECRET
          containers:
            - name: agent
              image: $image
              env:
                - name: SESSION_NAME
                  value: $name
                - name: JFS_MOUNT_OPTS
                  value: "$JFS_OPTS"
                - name: ENDPOINT_DNS
                  value: _iroh.$(endpoint_z32 < "$dir/iroh_secret").dns.iroh.link
                - name: IROH_SECRET
                  valueFrom:
                    secretKeyRef: { name: agent-$name, key: IROH_SECRET }
                - name: AUTHORIZED_KEYS_B64
                  valueFrom:
                    secretKeyRef: { name: agent-$name, key: AUTHORIZED_KEYS_B64 }
                - name: SSH_HOST_KEY_B64
                  valueFrom:
                    secretKeyRef: { name: agent-$name, key: SSH_HOST_KEY_B64 }
                - name: PROVIDER_KEYS
                  value: "${provider_keys% }"
$provider_env
$home_env
      networkInterfaces:
        - network:
            name: $NETWORK
  placements:
    - name: default
      locations:
        - name: $LOCATION
      scaleSettings:
        minReplicas: 1
EOF
  echo "$harness" > "$dir/harness"
  echo "created agent-$name ($harness: $image); waiting for SSH..." >&2
  local t0=$SECONDS
  # Subshell: cmd_ssh execs ssh.
  until (cmd_ssh "$name" -o ConnectTimeout=20 -o BatchMode=yes true) 2>/dev/null; do
    [ $((SECONDS - t0)) -lt 300 ] || die "no SSH after 5 min; try: agent-sandbox logs $name"
    sleep 10
  done
  echo "ready after $((SECONDS - t0))s: agent-sandbox ssh $name" >&2
}

cmd_ssh() {
  local name=${1:?usage: agent-sandbox ssh NAME [ssh args...]}; shift
  local dir; dir=$(session_dir "$name")
  [ -f "$dir/ticket" ] || die "no local state for $name"
  local dp; dp=$(dumbpipe_bin)
  # Options must precede the destination; anything after "--" is the command.
  local opts=() cmd=()
  [ -f "$dir/identity" ] && opts+=(-i "$(cat "$dir/identity")" -o IdentitiesOnly=yes)
  while [ $# -gt 0 ]; do
    case $1 in --) shift; cmd=("$@"); break ;; -o|-L|-R|-D|-i) opts+=("$1" "$2"); shift 2 ;;
      -*) opts+=("$1"); shift ;; *) cmd=("$@"); break ;; esac
  done
  exec ssh -o "ProxyCommand=$dp connect $(cat "$dir/ticket") 2>/dev/null" \
    -o "UserKnownHostsFile=$dir/known_hosts" -o "HostKeyAlias=agent-$name" \
    -o StrictHostKeyChecking=yes -o ServerAliveInterval=30 \
    "${opts[@]}" "root@agent-$name" "${cmd[@]}"
}

cmd_ls() {
  local d n
  echo "== workloads"; datumctl compute workloads 2>/dev/null | awk 'NR==1 || /^agent-/'
  echo "== local sessions ($STATE)"
  for d in "$STATE"/*/; do
    [ -d "$d" ] || continue
    n=$(basename "$d")
    printf '%-20s %s\n' "$n" "$(cat "$d/harness" 2>/dev/null || echo '?')"
  done
}

cmd_logs() {
  local name=${1:?usage: agent-sandbox logs NAME}; shift
  datumctl compute logs "agent-$name" "$@"
}

cmd_rm() {
  local name=${1:?usage: agent-sandbox rm NAME}
  local dir; dir=$(session_dir "$name")
  # Persist RAM workspaces (/work) to the shared home and release their locks
  # before the instance goes, so another session can open them right away.
  if [ -f "$dir/ticket" ]; then
    (cmd_ssh "$name" -o BatchMode=yes -o ConnectTimeout=20 -- \
       'HOME=/home/agent; [ -d /work ] && ws close --all') 2>/dev/null \
      && echo "workspaces saved" >&2 || echo "agent-sandbox: could not save workspaces of $name" >&2
  fi
  datumctl delete workload "agent-$name" 2>&1 | tail -1 || true
  datumctl delete secret "agent-$name" 2>&1 | tail -1 || true
  rm -rf "$dir"
}

case ${1:-} in
  new|ssh|ls|logs|rm) c=$1; shift; "cmd_$c" "$@" ;;
  *) usage ;;
esac
